{
  "name": "@linxin666/dsh-ops",
  "description": "Test-environment ops workspace for the dsh web GUI: a free-form tree of systems / services / servers / tasks, a server repository backed by the dsh-ssh host store, script tasks with parameters, orchestration flows, and run logs. The AI authoring loop uses the native DSH conversation; this package only carries the server context and a draft-write tool.",
  "version": "0.4.19",
  "icon": "icon.svg",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "icon.svg",
    "locale"
  ],
  "license": "Apache-2.0"
}
